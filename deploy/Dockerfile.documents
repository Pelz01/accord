FROM node:24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS base
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils tesseract-ocr tesseract-ocr-eng fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
FROM base AS verify
COPY server/document-worker.mjs ./server/document-worker.mjs
COPY scripts/documents-smoke.mjs ./scripts/documents-smoke.mjs
COPY fixtures/documents ./fixtures/documents
ENV ACCORD_SMOKE_NO_FILE=1
USER node
RUN node scripts/documents-smoke.mjs
FROM base
COPY --from=verify /app/server/document-worker.mjs ./document-worker.mjs
USER node
ENV PORT=3002
EXPOSE 3002
CMD ["node", "document-worker.mjs"]
