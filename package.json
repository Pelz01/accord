{
  "name": "accord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build:frontend": "tsc --noEmit && vite build",
    "build:api": "esbuild server/runtime.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist-api/index.js",
    "start:api": "node dist-api/index.js",
    "build": "npm run build:frontend && npm run build:api",
    "build:sites": "npm run build:frontend && node scripts/build-hosted.mjs",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:sites": "node scripts/check-hosted.mjs",
    "verify:hosted": "tsx scripts/hosted-smoke.ts",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/bodoni-moda": "5.3.0",
    "@fontsource/manrope": "5.2.8",
    "@fontsource/public-sans": "5.2.7",
    "@hot-labs/near-connect": "0.12.0",
    "dotenv": "17.2.3",
    "fastify": "5.12.8",
    "lucide-react": "0.548.0",
    "near-api-js": "7.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "binaryen": "132.0.0",
    "concurrently": "9.2.5",
    "esbuild": "0.28.2",
    "prettier": "3.8.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
